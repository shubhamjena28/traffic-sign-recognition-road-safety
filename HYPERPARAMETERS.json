{
  "reproducibility": {
    "global_seed": 42,
    "deterministic_cudnn": true,
    "benchmark_cudnn": false,
    "python_hash_seed": 42,
    "java_random_seed": 42
  },
  "perception_yolo": {
    "model_name": "yolov8n",
    "imgsz": 640,
    "epochs": 100,
    "batch_size": 16,
    "lr0": 0.01,
    "lrf": 0.01,
    "optimizer": "SGD",
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "conf_threshold": 0.25,
    "iou_threshold": 0.50,
    "nms_threshold": 0.45,
    "device": "cpu",
    "classes": {
      "0": "stop",
      "1": "speed",
      "2": "danger"
    }
  },
  "classifier_resnet18": {
    "model_name": "resnet18",
    "crop_size": 64,
    "batch_size": 32,
    "epochs": 10,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "optimizer": "Adam",
    "num_classes": 3
  },
  "sequence_lstm_risk": {
    "model_name": "lstm_risk_v1",
    "sequence_length": 10,
    "feature_dim": 4,
    "hidden_dim": 64,
    "num_layers": 2,
    "activation": "tanh",
    "learning_rate": 0.001,
    "batch_size": 16,
    "epochs": 20,
    "risk_classes": {
      "0": "LOW",
      "1": "MEDIUM",
      "2": "HIGH"
    }
  },
  "conditional_vae": {
    "model_name": "cvae_gtsrb_v1",
    "latent_dim": 32,
    "image_size": 64,
    "learning_rate": 0.001,
    "batch_size": 32,
    "epochs": 25,
    "kl_weight": 0.001
  },
  "java_app_runtime": {
    "default_speed_kmh": 68.0,
    "min_confidence": 0.50,
    "nms_iou_threshold": 0.45,
    "letterbox_size": 640,
    "letterbox_pad_color": [114, 114, 114],
    "input_source": "data/images/test",
    "output_directory": "data/output_frames",
    "run_log_csv": "logs/java_runs_log.csv"
  },
  "logging": {
    "experiments_log_csv": "logs/experiments_log.csv",
    "runs_log_csv": "runs/experiment_runs.csv"
  }
}
